# Configure locally; do not share or commit .env.
PORTAL_URL=
# Current login flow uses the password field; PORTAL_USERNAME is reserved.
PORTAL_USERNAME=
PORTAL_PASSWORD=
HEADLESS=false

# API server
API_PORT=3000
API_TOKEN=

# JWE uses a server RSA key pair generated locally in .local-keys/.
# The private key remains on this local Express backend; the client fetches only the public key.
# Run: npm run keys:generate

# Set true to enable intermediate page inspection logs/screenshots.
AUTOMATION_DIAGNOSTICS=false

# Keep false by default. Set true only when PORTAL_URL is the isolated demo simulator.
ALLOW_DEMO_ORDER_SUBMISSION=false
