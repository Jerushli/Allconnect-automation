# Configure locally; do not share or commit .env.
PORTAL_URL=
# Current login flow uses the password field; PORTAL_USERNAME is reserved.
PORTAL_USERNAME=
PORTAL_PASSWORD=
HEADLESS=false

# API server
API_PORT=3000
API_TOKEN=

# JWE uses a server RSA key pair generated locally in .local-keys/.
# The private key remains on this local Express backend; the client fetches only the public key.
# Run: npm run keys:generate

# Set true to enable intermediate page inspection logs/screenshots.
AUTOMATION_DIAGNOSTICS=false

# Keep false by default. Set true only for the isolated simulator UI transition to Order Summary.
# This does not submit a real order.
ALLOW_DEMO_ORDER_SUBMISSION=false

# Browser reliability limits (milliseconds)
BROWSER_LAUNCH_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=15000
BROWSER_NAVIGATION_TIMEOUT_MS=30000
AUTOMATION_MAX_RUNTIME_MS=900000

# Optional: keep the visible local browser open after a run for inspection
CLOSE_BROWSER_AFTER_RUN=false

# Persistent job history path (defaults to .data/jobs.json)
# JOB_STORE_PATH=.data/jobs.json
