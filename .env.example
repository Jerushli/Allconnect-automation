# Configure locally; do not share or commit .env.
PORTAL_URL=
# Current login flow uses the password field; PORTAL_USERNAME is reserved.
PORTAL_USERNAME=
PORTAL_PASSWORD=
HEADLESS=false

# API server
API_PORT=3000
API_TOKEN=

# EZ-Enroll No encrypted identity workflow
# SENSITIVE_DATA_KEY must be base64 for exactly 32 random bytes.
SENSITIVE_DATA_KEY=
SENSITIVE_DATA_ACCESS_TOKEN=

# Set true to enable intermediate page inspection logs/screenshots.
AUTOMATION_DIAGNOSTICS=false
